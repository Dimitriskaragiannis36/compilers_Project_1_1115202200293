/* Simple +/-/* expression language; parser evaluates constant expressions on the fly */
/**
 *  Package and Import Specifications
 */
import java_cup.runtime.*;

/**
 *  Usercode Components
 */
parser code {:
    // Connect this parser to a scanner!
    Scanner s;
    Parser(Scanner s) { this.s = s; }
:};

/* Define how to connect to the scanner */
scan with {: return s.next_token(); :};

/**
 *  Symbol Lists
 */

/* Terminals */
terminal LPAREN, RPAREN, LBRACE, RBRACE, COMMA, CONCAT, IF, ELSE, SUFFIX;
terminal String STRING_LITERAL;
terminal String ID;

/* Non-terminals */
non terminal String program;
non terminal String stmt_list;
non terminal String stmt;
non terminal String function_call;
non terminal String param_list;
non terminal String expr;
non terminal suffix_expr;

/**
 *  Precedence Declarations
 */
precedence left IF;
precedence left CONCAT; 
precedence right SUFFIX;

/* Grammar Rules */
program ::= stmt_list:sl  {: RESULT = sl; :};

/* Λίστα από statements */
stmt_list ::= stmt:s stmt_list:sl  {: RESULT = s + "\n" + sl; :}
           | stmt:s               {: RESULT = s; :};

/* Ένα statement μπορεί να είναι μια κλήση συνάρτησης */
stmt ::= function_call:fc  {: RESULT = fc; :}
      | IF LPAREN expr:e RPAREN stmt:s1 ELSE stmt:s2  
         {: RESULT = "if (" + e + ") " + s1 + " else " + s2; :};

/* Ορισμός μιας συνάρτησης */
function_call ::= ID:id LPAREN param_list:params RPAREN LBRACE expr:e RBRACE  
                  {: RESULT = id + "(" + params + ") {\n  " + e + "\n}"; :}
               | ID:id LPAREN RPAREN LBRACE expr:e RBRACE  
                  {: RESULT = id + "() {\n  " + e + "\n}"; :}
               | ID:id LPAREN param_list:params RPAREN  
                  {: RESULT = id + "(" + params + ")"; :}
               | ID:id LPAREN RPAREN  
                  {: RESULT = id + "()"; :};

/* Λίστα παραμέτρων (comma-separated) */
param_list ::= expr:e COMMA param_list:params  {: RESULT = e + ", " + params; :}
             | expr:e                          {: RESULT = e; :};

/* Υποστήριξη πράξεων μέσα στο σώμα της συνάρτησης */
suffix_expr ::= STRING_LITERAL:s SUFFIX expr:e  
                {: RESULT = "reverse " + s + " prefix reverse " + e; :};

expr ::= expr:e1 SUFFIX expr:e2  {: RESULT = "reverse " + e1 + " prefix reverse " + e2; :}
      | expr:e1 CONCAT expr:e2  {: RESULT = e1 + " + " + e2; :}
      | STRING_LITERAL:s        {: RESULT = s; :}
      | ID:id                   {: RESULT = id; :}
      | function_call:fc         {: RESULT = fc; :};

