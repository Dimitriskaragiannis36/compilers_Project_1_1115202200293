/* Στάδιο 2: IR  ->  Java.  Ίδια terminals (και σειρά) με τον parser.cup ώστε να συμφωνεί το sym.java */
import java_cup.runtime.*;
import java.util.*;

parser code {:
    Scanner s;
    Parser2(Scanner s) { this.s = s; }

    List<String> methods = new ArrayList<String>();
    List<String> mainBody = new ArrayList<String>();
    boolean seenCall = false;

    /* Το IR δεν επιτρέπει suffix και "=": οι αντίστοιχοι κανόνες υπάρχουν μόνο για να δώσουν σαφές σφάλμα. */
    static String reject(String what) {
        throw new RuntimeException("IR error: '" + what + "' is not allowed in the IR");
    }

    static String describe(Symbol t) {
        if (t.sym == sym.EOF) return "IR syntax error: unexpected end of input";
        String pos = t.left >= 0 ? " at line " + (t.left + 1) + ", column " + (t.right + 1) : "";
        return "IR syntax error" + pos + (t.value != null ? " near " + t.value : "");
    }
    public void syntax_error(Symbol cur) { throw new RuntimeException(describe(cur)); }
    public void unrecovered_syntax_error(Symbol cur) { throw new RuntimeException(describe(cur)); }
:};

scan with {: return s.next_token(); :};

terminal LPAREN, RPAREN, LBRACE, RBRACE, COMMA, CONCAT, IF, ELSE, SUFFIX, PREFIX, REVERSE, EQUAL;
terminal String STRING_LITERAL, ID;

non terminal String program;
non terminal items, item;
non terminal Ex expr;
non terminal String cond;
non terminal java.util.List<Ex> args;

precedence nonassoc IF, ELSE;
precedence left CONCAT;
precedence right REVERSE;
precedence nonassoc ID;
precedence nonassoc LPAREN;

start with program;

program ::= items
    {:
        StringBuilder sb = new StringBuilder();
        sb.append("public class Translated {\n");
        sb.append("  public static void main(String[] args) {\n");
        for (String l : parser.mainBody) sb.append("    System.out.println(").append(l).append(");\n");
        sb.append("  }\n");
        for (String m : parser.methods) sb.append("\n").append(m);
        sb.append("}\n");
        RESULT = sb.toString();
    :};

items ::= /* empty */
        | items item
        ;

item ::= ID:id LPAREN args:a RPAREN LBRACE expr:body RBRACE
    {:
        if (!parser.mainBody.isEmpty())
            throw new RuntimeException("Function " + id + ": definitions must precede all top-level expressions");
        StringBuilder ps = new StringBuilder();
        for (Ex x : a) {
            if (!x.s.matches("[a-zA-Z_][a-zA-Z_0-9]*"))
                throw new RuntimeException("Function " + id + ": invalid parameter '" + x.s + "'");
            if (ps.length() > 0) ps.append(", ");
            ps.append("String ").append(x.s);
        }
        parser.methods.add("  public static String " + id + "(" + ps + ") {\n    return " + body.s + ";\n  }\n");
    :}
       | ID:id LPAREN RPAREN LBRACE expr:body RBRACE
    {:
        if (!parser.mainBody.isEmpty())
            throw new RuntimeException("Function " + id + ": definitions must precede all top-level expressions");
        parser.methods.add("  public static String " + id + "() {\n    return " + body.s + ";\n  }\n");
    :}
       | expr:e
    {: parser.mainBody.add(e.s); :}
       ;

args ::= expr:e                  {: RESULT = new ArrayList<Ex>(); RESULT.add(e); :}
       | args:l COMMA expr:e     {: l.add(e); RESULT = l; :}
       ;

expr ::= STRING_LITERAL:str      {: RESULT = new Ex(str, Ex.ATOM); :}
       | ID:id                   {: RESULT = new Ex(id, Ex.ATOM); :}
       | ID:id LPAREN RPAREN     {: RESULT = new Ex(id + "()", Ex.ATOM); :}
       | ID:id LPAREN args:a RPAREN
         {:
            StringBuilder sb = new StringBuilder(id).append("(");
            for (int i = 0; i < a.size(); i++) { if (i > 0) sb.append(", "); sb.append(a.get(i).s); }
            RESULT = new Ex(sb.append(")").toString(), Ex.ATOM);
         :}
       | LPAREN expr:e RPAREN    {: RESULT = new Ex("(" + e.s + ")", Ex.ATOM); :}
       | expr:a CONCAT expr:b
         {: RESULT = new Ex(Ex.wrapIf(a).s + " + " + Ex.wrapIf(b).s, Ex.CAT); :}
       | REVERSE expr:e
         {: RESULT = new Ex("new StringBuilder(" + e.s + ").reverse().toString()", Ex.ATOM); :}
       | IF LPAREN cond:c RPAREN expr:t ELSE expr:e
         {: RESULT = new Ex(c + " ? " + Ex.wrapIf(t).s + " : " + e.s, Ex.IF); :}
       ;

/* a prefix b  =  "το a είναι πρόθεμα του b"  =  b.startsWith(a) */
cond ::= expr:a PREFIX expr:b    {: RESULT = Ex.wrapAtom(b).s + ".startsWith(" + a.s + ")"; :}
       | expr SUFFIX expr        {: RESULT = Parser2.reject("suffix"); :}
       | expr EQUAL expr         {: RESULT = Parser2.reject("="); :}
       ;