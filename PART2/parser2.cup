import java_cup.runtime.*;

parser code {: 
    Scanner2 s;
    Parser2(Scanner2 s) { this.s = s; }
:};

scan with {: return s.next_token(); :};

terminal LPAREN, RPAREN, LBRACE, RBRACE, COMMA, CONCAT;
terminal String STRING_LITERAL;
terminal String ID;

non terminal String program;
non terminal String stmt_list;
non terminal String stmt;
non terminal String function_call;
non terminal String function_def;
non terminal String param_list;
non terminal String expr;
non terminal String expr_tail;
non terminal String term;

program ::= stmt_list:sl  
    {: RESULT = "public class Translated {\n  public static void main(String[] args) {\n" + sl + "  }\n}"; :};

stmt_list ::= stmt:s stmt_list:sl  {: RESULT = s + "\n" + sl; :}
           | stmt:s               {: RESULT = s; :};

stmt ::= function_def:fd  {: RESULT = fd; :}
      | function_call:fc  {: RESULT = "    System.out.println(" + fc + ");"; :};

function_def ::= ID:id LPAREN param_list:params RPAREN LBRACE expr:e RBRACE  
    {: RESULT = "  public static String " + id + "(" + params + ") {\n    return " + e + ";\n  }"; :}
    | ID:id LPAREN RPAREN LBRACE expr:e RBRACE  
    {: RESULT = "  public static String " + id + "() {\n    return " + e + ";\n  }"; :};

param_list ::= ID:id COMMA param_list:params  {: RESULT = "String " + id + ", " + params; :}
             | ID:id                          {: RESULT = "String " + id; :};

function_call ::= ID:id LPAREN param_list:params RPAREN  
    {: RESULT = id + "(" + params + ")"; :}
    | ID:id LPAREN RPAREN  
    {: RESULT = id + "()"; :};

expr ::= term:t expr_tail:et  {: RESULT = t + et; :};

expr_tail ::= CONCAT term:t expr_tail:et  {: RESULT = " + " + t + et; :}
           |                              {: RESULT = ""; :};

term ::= STRING_LITERAL:s  {: RESULT = s; :}
       | ID:id            {: RESULT = id; :}
       | function_call:fc  {: RESULT = fc; :};
