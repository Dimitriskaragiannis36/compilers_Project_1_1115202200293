/* Simple +/-/* expression language; parser evaluates constant expressions on the fly */
/**
 *  Package and Import Specifications
 */
import java_cup.runtime.*;

parser code {:
    // Connect this parser to a scanner!
    Scanner s;
    String functionDefinitions = "";  // Θα κρατάμε εδώ όλες τις συναρτήσεις
    Parser2(Scanner s) { this.s = s; }
:};


/* Define how to connect to the scanner */
scan with {: return s.next_token(); :};  

/**
 *  Symbol Lists
 */

/* Terminals */
terminal LPAREN, RPAREN, LBRACE, RBRACE, COMMA, CONCAT, IF, ELSE, SUFFIX, PREFIX, REVERSE, EQUAL, LOG_EQUAL; 
terminal String STRING_LITERAL;
terminal String ID;

/* Non-terminals */
non terminal String program;
non terminal String stmt_list;
non terminal String stmt;
non terminal String function_call;
non terminal String param_list;
non terminal String expr;
non terminal String expr_tail;
non terminal String term;
non terminal String if_expr;
non terminal String condition;
non terminal String condition_tail;


/**
 *  Precedence Declarations
 */
precedence left IF;
precedence left CONCAT; 
precedence left REVERSE;

/* Grammar Rules */
program ::= stmt_list:sl  {: 
    RESULT = "public class Translated {\n" +
             functionDefinitions +  // Εδώ θα μπαίνουν όλες οι συναρτήσεις
             "  public static void main(String[] args) {\n" +
             sl +  // Εδώ θα μπαίνουν οι κλήσεις συναρτήσεων και άλλες εκφράσεις
             "  }\n" +
             "}\n";
:};

/*Statement list */
stmt_list ::= stmt:s stmt_list:sl  {: RESULT = s + "\n" + sl; :}
           | stmt:s               {: RESULT = s; :};

/* simple Statement*/
stmt ::= function_call:fc  {: RESULT = "    System.out.println(" + fc + ");"; :}
        |ID:id LPAREN param_list:params RPAREN LBRACE expr:e RBRACE  
          {: 
              functionDefinitions += "  public static String " + id + "(" + params + ") {\n" +
                                     "    return " + e + ";\n" +
                                     "  }\n"; 
              RESULT = "";  
          :}
       | ID:id LPAREN RPAREN LBRACE expr:e RBRACE  
          {: 
              functionDefinitions += "  public static String " + id + "() {\n" +
                                     "    return " + e + ";\n" +
                                     "  }\n"; 
              RESULT = "";  
          :};

/*function*/
function_call ::= ID:id LPAREN param_list:params RPAREN  
                  {: RESULT = id + "(" + params + ")"; :}
               | ID:id LPAREN RPAREN  
                  {: RESULT = id + "()"; :};

/* parameter list (comma-separated) */
param_list ::= expr:e COMMA param_list:params  {: RESULT = e + ", " + params; :}
             | expr:e                          {: RESULT = e; :};


/* expressions */
expr ::= term:t expr_tail:et  {: RESULT = t + et; :}
      | if_expr:ie            {: RESULT = ie; :};

/* if_else expressions */
if_expr ::= IF LPAREN condition:c RPAREN expr:e1 ELSE expr:e2  
              {: RESULT = "if (" + c + ") " + e1 + " else " + e2; :};

/* conditions */
condition ::= expr:e condition_tail:ct  
    {: RESULT = e + ct; :};

/* what follows a condition */
condition_tail ::= PREFIX expr:e2  
                      {: RESULT = ".startsWith(" + e2 + ")"; :}
                | LOG_EQUAL expr:e2   
                      {: RESULT = ".equals(" + e2 + ")"; :}
                | REVERSE expr:e2  
                      {: RESULT = "new StringBuilder(" + e2 + ").reverse().toString()"; :}
                | ;  

/* what follows an expression */
expr_tail ::= CONCAT term:t expr_tail:et  {: RESULT = " + " + t + et; :}
           |                              {: RESULT = ""; :};

/*terms*/
term ::= REVERSE term:t  {: RESULT = "new StringBuilder(" + t + ").reverse().toString()"; :}
       | STRING_LITERAL:s  {: RESULT = s; :}
       | ID:id            {: RESULT = id; :}
       | function_call:fc  {: RESULT = fc; :};
       