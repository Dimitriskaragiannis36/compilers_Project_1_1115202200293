/* Simple +/-/* expression language; parser evaluates constant expressions on the fly */
/**
 *  Package and Import Specifications
 */
import java_cup.runtime.*;

/**
 *  Usercode Components
 */
parser code {:
    // Connect this parser to a scanner!
    Scanner s;
    Parser2(Scanner s) { this.s = s; }
:};

/* Define how to connect to the scanner */
scan with {: return s.next_token(); :};

/**
 *  Symbol Lists
 */

/* Terminals - (remember the scanner) */
terminal LPAREN, RPAREN, LBRACE, RBRACE, COMMA, CONCAT, IF, ELSE, SUFFIX, PREFIX, REVERSE, EQUAL, LOG_EQUAL;
terminal String STRING_LITERAL;
terminal String ID;

/* Non-terminals */
non terminal String program;
non terminal String fun_list;
non terminal String fun_call;
non terminal String fun_def;
non terminal String par_list;
non terminal String par;
non terminal String expr;
non terminal String if_expr;
non terminal String expr2;
non terminal String term_list;
non terminal String term;
non terminal String term2;
non terminal String if_expr_reverse;
non terminal String if_expr_string;
non terminal String if_expr_id;



/**
 *  Precedence Declarations
 */
precedence left IF, ELSE;
precedence left CONCAT; 
precedence left REVERSE;
precedence left COMMA;

/* Grammar Rules */

/* Functions followed by function calls */
program ::= fun_list:fl fun_call:fc  
  {: 
    RESULT = "public class Translated {\n" +
             "  public static void main(String[] args) {\n" +
             fc + "  }\n\n" + fl + "}";
  :};


/* -------------------FUNCTION DEFINITION PART------------ */
/* Function definitions followed by functions definitions */
fun_list ::= fun_list:fl fun_def:fd  {: RESULT = fl + "\n" + fd + "\n"; :}
          | fun_def:fd               {: RESULT = fd + "\n"; :}
        ;

/* Function definitions */
fun_def ::= ID:id LPAREN par_list:pl RPAREN LBRACE expr:e RBRACE
              {: RESULT = "  public static String " + id + "(" + pl + ") {\n" + 
                e + "\n" + 
               "  }\n"; 
              :}
          | ID:id LPAREN RPAREN LBRACE expr:e RBRACE
              {: RESULT = "  public static String " + id + "() {\n" + 
                e + "\n" + 
               "  }\n"; 
              :}
        ;

/* List of parameters */
par_list ::= par:p                 {: RESULT = "String " + p; :}
           | par_list:pl COMMA par:p  {: RESULT = pl + ", String " + p; :}
        ;

/* Parameter */
par ::= ID:id  {: RESULT = id; :};

/* Expressions */
expr ::= STRING_LITERAL:str  {: RESULT = "    return " + str + ";"; :}
       | ID:id               {: RESULT = "    return " + id; :}
       | expr:e1 CONCAT expr:e2  {: RESULT = "    return " + e1.replace("    return ", "").replace(";", "") + 
                           " + " + e2.replace("    return ", "") + ";"; :}
       | IF LPAREN if_expr:cond RPAREN expr:e1 ELSE expr:e2  
         {: RESULT = "if (" + cond + ") {\n    return " + e1 + ";\n  } else {\n" + e2 + ";\n  }"; :}
       | ID:id LPAREN expr2:ex RPAREN  
         {: RESULT = id + "(" + ex + ")"; :}
       | ID:id LPAREN RPAREN  
         {: RESULT = id + "()"; :}
       ; 

/* IF expression conditions */
if_expr ::= if_expr_reverse: ifer    {: RESULT = ifer; :}
          | if_expr_string: ifes     {: RESULT = ifes; :}
          | if_expr_id: ifed         {: RESULT = ifed; :}
          ;

/* REVERSE-based conditions */
if_expr_reverse ::= REVERSE STRING_LITERAL:str PREFIX REVERSE ID:id  
                      {: RESULT = "new StringBuilder(" + str + ").reverse().toString().startsWith(new StringBuilder(" + id + ").reverse().toString())"; :}
                  | REVERSE STRING_LITERAL:str SUFFIX REVERSE ID:id  
                      {: RESULT = "new StringBuilder(" + str + ").reverse().toString().endsWith(new StringBuilder(" + id + ").reverse().toString())"; :}
                  | REVERSE STRING_LITERAL:str EQUAL REVERSE ID:id  
                      {: RESULT = "new StringBuilder(" + str + ").reverse().toString().equals(new StringBuilder(" + id + ").reverse().toString())"; :}
                  | REVERSE ID:id PREFIX REVERSE STRING_LITERAL:str  
                      {: RESULT = "new StringBuilder(" + id + ").reverse().toString().startsWith(new StringBuilder(" + str + ").reverse().toString())"; :}
                  | REVERSE ID:id SUFFIX REVERSE STRING_LITERAL:str  
                      {: RESULT = "new StringBuilder(" + id + ").reverse().toString().endsWith(new StringBuilder(" + str + ").reverse().toString())"; :}
                  | REVERSE ID:id EQUAL REVERSE STRING_LITERAL:str  
                      {: RESULT = "new StringBuilder(" + id + ").reverse().toString().equals(new StringBuilder(" + str + ").reverse().toString())"; :}
                  ;

/* STRING_LITERAL-based conditions */
if_expr_string ::= STRING_LITERAL:str PREFIX ID:id  
                     {: RESULT = str + ".startsWith(" + id + ")"; :}
                 | STRING_LITERAL:str SUFFIX ID:id  
                       {: RESULT = str + ".endsWith(" + id + ")"; :}
                 | STRING_LITERAL:str EQUAL ID:id  
                        {: RESULT = str + ".equals(" + id + ")"; :}
                 ;

/* ID-based conditions */
if_expr_id ::= ID:id PREFIX STRING_LITERAL:str  
                  {: RESULT = id + ".startsWith(" + str + ")"; :}
             | ID:id SUFFIX STRING_LITERAL:str  
                  {: RESULT = id + ".endsWith(" + str + ")"; :}
             | ID:id EQUAL STRING_LITERAL:str  
                  {: RESULT = id + ".equals(" + str + ")"; :}
             ;

/* Expressions 2 */
expr2 ::= STRING_LITERAL:str  {: RESULT = str; :}
        | ID:id LPAREN expr2:ex RPAREN  
          {: RESULT = id + "(" + ex + ")"; :}
        | expr2:e1 COMMA expr2:e2  
          {: RESULT = e1 + ", " + e2; :}
        | ID:id  
          {: RESULT = id; :}
        ;


/* ------------------FUNCTION CALLS PART--------------------- */
/* Function calls */
fun_call ::= term_list:tl  {: RESULT = tl; :}
            | /* empty */  {: RESULT = ""; :}
            ;

/* List of terms */
term_list ::= term_list:tl term:t  {: RESULT = tl + "\n    System.out.println(" + t + ");"; :}
            | term:t               {: RESULT = "    System.out.println(" + t + ");"; :}
            ;

/* term */
term ::= ID:id LPAREN term2:t2 RPAREN  
          {: RESULT = id + "(" + t2 + ")"; :}
        | ID:id LPAREN RPAREN  
          {: RESULT = id + "()"; :}
        ;

/* term2 */
term2 ::= term2:t2 COMMA STRING_LITERAL:str  
           {: RESULT = t2 + ", " + str; :}
         | term2:t2 COMMA term:t  
           {: RESULT = t2 + ", " + t; :}
         | STRING_LITERAL:str  
           {: RESULT = str; :}
         | term:t  
           {: RESULT = t; :}
         ;
 

