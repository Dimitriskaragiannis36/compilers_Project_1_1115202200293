/* Simple +/-/* expression language; parser evaluates constant expressions on the fly*/
/**
 *  Package and Import Specifications
 */
import java_cup.runtime.*;

/**
 *  Usercode Components
 */
parser code {:
    // Connect this parser to a scanner!
    Scanner s;
    Parser(Scanner s){ this.s=s; }
:}

/* define how to connect to the scanner! */
scan with {: return s.next_token(); :};

/**
 *  Symbol Lists
 */

/* Terminals (tokens returned by the scanner). */
terminal IF, ELSE, PREFIX;
terminal CONCAT, REVERSE, AND;
terminal LPAREN, RPAREN, LBRACE, RBRACE, COMMA, SEMI;
terminal String     STRING_LITERAL;        // our scanner provides numbers as strings
terminal String ID;

/*  Non terminals */
non terminal String fun_stmt_list, function_def, stmt;
non terminal param_list, expr, arg_list, arg_list_tail;
non terminal stmt_list, if_expr, bool_expr, prefix_expr, param_list_tail;

/**
 *  Precedence Declarations
 */
precedence left IF;
precedence left AND;
precedence left CONCAT; 
precedence left REVERSE;

/**
 *  The Grammar Rules
 */

fun_stmt_list ::= function_def:f SEMI fun_stmt_list:fl   {: System.out.println(f + ";"); RESULT = f + ";\n" + fl; :}
                | stmt:s fun_stmt_list:fl               {: System.out.println(s); RESULT = s + "\n" + fl; :}
                | function_def:f SEMI                   {: System.out.println(f + ";"); RESULT = f + ";"; :}
                | stmt:s                                {: System.out.println(s); RESULT = s; :}
                ;


function_def ::= ID:id LPAREN param_list:p RPAREN LBRACE stmt_list:s RBRACE 
               {: RESULT = "function " + id + "(" + p + ") {\n" + s + "\n}"; :}
               ;


param_list ::= ID:id param_list_tail:pt      {: RESULT = id + pt; :}
            ;


param_list_tail ::= COMMA ID:id param_list_tail:pt     {: RESULT = ", " + id + pt; :}
                  |                                    {: RESULT = ""; :}
                  ;

stmt_list ::= stmt:s stmt_list:sl   {: System.out.println(s); RESULT = s + "\n" + sl; :}
           | stmt:s                 {: System.out.println(s); RESULT = s; :}
           ;



stmt ::= expr:e              {: RESULT = e + ";"; :}
       | if_expr:ie          {: RESULT = ie; :}
       ;


expr ::= STRING_LITERAL:s                      {: RESULT = s; :}
      | ID:id LPAREN arg_list:al RPAREN        {: RESULT = id + "(" + al + ")"; :}
      | expr:e1 CONCAT expr:e2                 {: RESULT = e1 + " + " + e2; :}
      | REVERSE expr:e                         {: RESULT = "reverse(" + e + ")"; :}
      ;


arg_list ::= expr:e arg_list_tail:alt          {: RESULT = e + alt; :}
           ;


arg_list_tail ::= COMMA expr:e arg_list_tail:alt    {: RESULT = ", " + e + alt; :}
                |                                   {: RESULT = ""; :}
                ;


if_expr ::= IF LPAREN bool_expr:b RPAREN LBRACE stmt_list:s1 RBRACE ELSE LBRACE stmt_list:s2 RBRACE  
            {: System.out.println("if (" + b + ") {\n" + s1 + "\n} else {\n" + s2 + "\n}"); 
               RESULT = "if (" + b + ") {\n" + s1 + "\n} else {\n" + s2 + "\n}"; :}  
         ;

 
bool_expr ::= prefix_expr:p1 AND prefix_expr:p2   {: RESULT = p1 + " && " + p2; :}
           | prefix_expr:p                        {: RESULT = p; :}
           ;


prefix_expr ::= expr:e1 PREFIX expr:e2                    {: RESULT = e1 + ".startsWith(" + e2 + ")"; :}
              | REVERSE expr:e1 PREFIX expr:e2            {: RESULT = "reverse(" + e1 + ").startsWith(" + e2 + ")"; :}
              | REVERSE expr:e1 PREFIX REVERSE expr:e2    {: RESULT = "reverse(" + e1 + ").startsWith(reverse(" + e2 + "))"; :}  // Υλοποίηση Suffix μέσω Reverse+Prefix
              ;