/* Simple +/-/* expression language; parser evaluates constant expressions on the fly */
/**
 *  Package and Import Specifications
 */
import java_cup.runtime.*;

/**
 *  Usercode Components
 */
parser code {:
    // Connect this parser to a scanner!
    Scanner s;
    Parser(Scanner s) { this.s = s; }
:};

/* Define how to connect to the scanner */
scan with {: return s.next_token(); :};

/**
 *  Symbol Lists
 */

/* Terminals - (remember the scanner) */
terminal LPAREN, RPAREN, LBRACE, RBRACE, COMMA, CONCAT, IF, ELSE, SUFFIX, PREFIX, REVERSE, EQUAL, LOG_EQUAL;
terminal String STRING_LITERAL;
terminal String ID;

/* Non-terminals */
non terminal String program;
non terminal String fun_list;
non terminal String fun_call;
non terminal String fun_def;
non terminal String par_list;
non terminal String par;
non terminal String expr;
non terminal String if_expr;
non terminal String expr2;
non terminal String term_list;
non terminal String term;
non terminal String term2;



/**
 *  Precedence Declarations
 */
precedence left IF, ELSE;
precedence left CONCAT; 
precedence left REVERSE;
precedence left COMMA;

/* Grammar Rules */

/* Functions followed by function calls */
program ::= fun_list fun_call; 

/*FUNCTION DECLARATION PART*/
/* Function definitions followed by functions definitions  */
fun_list ::= fun_list fun_def        
          | fun_def
        ;

fun_def ::= ID LPAREN par_list RPAREN LBRACE expr RBRACE
            | ID LPAREN RPAREN LBRACE expr RBRACE
            ;

par_list ::=par 
             |par_list COMMA par
             ;

par ::= ID
        ;

expr  ::= STRING_LITERAL
        | ID
        | expr CONCAT expr
        | IF LPAREN if_expr RPAREN expr ELSE expr
        | ID LPAREN expr2 RPAREN
        | ID LPAREN RPAREN
        ;  

if_expr ::= REVERSE STRING_LITERAL PREFIX REVERSE ID
          | REVERSE STRING_LITERAL SUFFIX REVERSE ID
          | REVERSE STRING_LITERAL EQUAL REVERSE ID
          | STRING_LITERAL PREFIX ID
          | STRING_LITERAL SUFFIX ID
          | STRING_LITERAL EQUAL ID
          | REVERSE ID PREFIX REVERSE STRING_LITERAL
          | REVERSE ID SUFFIX REVERSE STRING_LITERAL
          | REVERSE ID EQUAL REVERSE STRING_LITERAL 
          | ID PREFIX STRING_LITERAL
          | ID SUFFIX STRING_LITERAL
          | ID EQUAL STRING_LITERAL
          ;  

expr2 ::= STRING_LITERAL
        | ID LPAREN expr2 RPAREN 
        | expr2 COMMA expr2
        | ID
        ;  


/* FUNCTION CALLS PART */            

fun_call ::= term_list
            | /*empty*/
            ;


term_list ::= term_list term
            | term
            ;


term ::= ID LPAREN term2 RPAREN
        | ID LPAREN RPAREN
        ;

term2 ::= term2 COMMA STRING_LITERAL
           | term2 COMMA term
           | STRING_LITERAL
           | term
           ;   

